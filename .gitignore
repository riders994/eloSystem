.idea/
.venv/
__pycache__/
*.pyc

# Packaging / build artifacts
build/
dist/
*.egg-info/
.pytest_cache/

# Resources: ignore local data/configs, but keep the directory structure,
# the historical elos/, and tracked *.example.yml config templates.
resources/*
!resources/elos/
!resources/configs/
!resources/ratings/
resources/configs/*
!resources/configs/*.example.yml
resources/ratings/*
!resources/ratings/.gitkeep

# Anonymization reversal maps. These hold the real names the DB tokens stand
# for, so committing one undoes the anonymizing. resources/* already covers the
# default location; spell it out so a later un-ignore cannot expose them, and
# catch the map files wherever anon_loc puts them.
resources/anon/
anon_*.json
